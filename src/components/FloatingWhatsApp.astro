---
// Quick contact buttons for WhatsApp and Direct Phone Call
const waNumber  = '919894821309';
const waMessage = encodeURIComponent('Hello ERMIS Global! I would like to know more about solar solutions for my property.');
const waURL     = `https://wa.me/${waNumber}?text=${waMessage}`;
const phoneURL  = 'tel:+919894821309';
---

<!-- Floating Actions Bar at right center -->
<div class="fixed top-1/2 -translate-y-1/2 right-4 sm:right-6 z-50 flex flex-col items-center gap-3">
  <!-- Call Button -->
  <a
    href={phoneURL}
    aria-label="Call us"
    class="group relative flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-full
           shadow-xl bg-brand-red hover:bg-[#a82d25] text-white transition-all duration-300 transform hover:scale-110
           focus:outline-none focus:ring-4 focus:ring-brand-red/40"
  >
    <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13
           a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0
           01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 12V5z"/>
    </svg>
    <span class="absolute right-full mr-3 top-1/2 -translate-y-1/2 px-2.5 py-1 bg-neutral-ink text-white text-xs font-semibold rounded-md opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity whitespace-nowrap shadow-md hidden sm:block">
      Call Us
    </span>
  </a>

  <!-- WhatsApp Button -->
  <a
    href={waURL}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with us on WhatsApp"
    class="group relative flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-full
           shadow-xl bg-[#25D366] hover:bg-[#1ebe5d] text-white transition-all duration-300 transform hover:scale-110
           focus:outline-none focus:ring-4 focus:ring-[#25D366]/40"
  >
    <!-- WhatsApp SVG icon -->
    <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15
               -.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475
               -.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52
               .149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207
               -.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372
               -.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2
               5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085
               1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.558 4.112 1.532 5.836L.057 23.25a.75.75 0
               001.019.95l5.636-1.484A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0
               21.75a9.712 9.712 0 01-5.113-1.449l-.367-.218-3.803 1.001 1.018-3.721-.24-.382A9.75
               9.75 0 1112 21.75z"/>
    </svg>

    <!-- Pulse ring -->
    <span class="absolute w-full h-full rounded-full bg-[#25D366] animate-ping opacity-30 -z-10"></span>

    <span class="absolute right-full mr-3 top-1/2 -translate-y-1/2 px-2.5 py-1 bg-neutral-ink text-white text-xs font-semibold rounded-md opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity whitespace-nowrap shadow-md hidden sm:block">
      WhatsApp Us
    </span>
  </a>
</div>
